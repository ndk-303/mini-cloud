server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  add_header X-Served-By $hostname always;

  location / {
    try_files $uri $uri/ =404;
  }

  location ^~ /blog/ {
    alias /usr/share/nginx/html/blog/;
    index index.html;
    autoindex off;
  }

  # Endpoint phục vụ Prometheus Scrape Target UP (HTTP 200)
  location /metrics {
    stub_status;
    access_log off;
  }
}
